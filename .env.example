# Local Gemini (AI Studio). Never commit the real key.
GEMINI_API_KEY=
# optional:
GEMINI_MODEL=gemini-2.5-flash

# Agent Engine deploy only. Local CLI ignores these.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# IBM watsonx.ai (optional). Local demo ignores these.
# Get an IBM Cloud API key + watsonx project id. Never commit the real values.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# optional:
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL=ibm/granite-3-8b-instruct
